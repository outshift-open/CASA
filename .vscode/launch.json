    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Auth Server Debugger",
            "type": "debugpy",
            "request": "launch",
            "envFile": "${workspaceFolder}/.env",
            "module": "uvicorn",
            "args": [
                "identity_auth_server.api.app:app",
                "--reload"
            ]
        },
        {
            "name": "Python Trusted Client Debugger",
            "type": "debugpy",
            "request": "launch",
            "envFile": "${workspaceFolder}/.env",
            "program": "${workspaceFolder}/demo/workshop/app/main.py"
        }
    ]
}
