# Build stage
FROM node:22-alpine AS builder

# Build argument for API URL (can be overridden at build time)
ARG VITE_API_BASE_URL=/api

# Set working directory
WORKDIR /app

# Enable Corepack and set Yarn version
RUN corepack enable && corepack prepare yarn@4.7.0 --activate

# Copy package files
COPY zta-explorer-ui/package.json zta-explorer-ui/yarn.lock zta-explorer-ui/.yarnrc.yml ./
COPY zta-explorer-ui/.yarn ./.yarn

# Install dependencies
RUN yarn install --immutable

# Copy source code
COPY zta-explorer-ui/ ./

# Create .env file dynamically from build args for Vite to inject during build
RUN echo "VITE_API_BASE_URL=${VITE_API_BASE_URL}" > .env

# Build the application
RUN yarn build

# Production stage
FROM nginx:alpine

# Copy custom nginx config
COPY deployments/docker/resources/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
