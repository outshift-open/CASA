{
  "info": {
    "name": "ZTA K8s CRD APIs",
    "description": "Test collection for Kubernetes Custom Resource Definition (CRD) REST APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "MultiAgentSystem CRDs",
      "item": [
        {
          "name": "Create MAS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiVersion\": \"zta.io/v1alpha1\",\n  \"kind\": \"MultiAgentSystem\",\n  \"metadata\": {\n    \"name\": \"prod-mas\",\n    \"namespace\": \"default\",\n    \"labels\": {\n      \"environment\": \"production\"\n    }\n  },\n  \"spec\": {\n    \"name\": \"Production MAS\",\n    \"authorizationServer\": \"prod-realm\",\n    \"enabledToolChecks\": [\n      \"DETERMINISTIC_TOOL_SELECTED\",\n      \"AI_POWERED_TOOL_MATCH\"\n    ],\n    \"apps\": [\n      {\n        \"name\": \"orchestrator\",\n        \"type\": \"agent\",\n        \"baseUrl\": \"http://orchestrator:8000\"\n      },\n      {\n        \"name\": \"filesystem-mcp\",\n        \"type\": \"mcp_server\",\n        \"baseUrl\": \"http://fs-mcp:8080\"\n      }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/k8s/namespaces/default/multiagentsystems",
              "host": ["{{base_url}}"],
              "path": ["k8s", "namespaces", "default", "multiagentsystems"]
            }
          }
        },
        {
          "name": "Get MAS by Name",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/k8s/namespaces/default/multiagentsystems/prod-mas",
              "host": ["{{base_url}}"],
              "path": ["k8s", "namespaces", "default", "multiagentsystems", "prod-mas"]
            }
          }
        },
        {
          "name": "List MAS in Namespace",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/k8s/namespaces/default/multiagentsystems",
              "host": ["{{base_url}}"],
              "path": ["k8s", "namespaces", "default", "multiagentsystems"]
            }
          }
        },
        {
          "name": "List All MAS",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/k8s/multiagentsystems",
              "host": ["{{base_url}}"],
              "path": ["k8s", "multiagentsystems"]
            }
          }
        },
        {
          "name": "List MAS with Namespace Filter",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/k8s/multiagentsystems?namespace=production",
              "host": ["{{base_url}}"],
              "path": ["k8s", "multiagentsystems"],
              "query": [
                {
                  "key": "namespace",
                  "value": "production"
                }
              ]
            }
          }
        },
        {
          "name": "Update MAS Spec",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spec\": {\n    \"name\": \"Production MAS (Updated)\",\n    \"authorizationServer\": \"prod-realm\",\n    \"enabledToolChecks\": [\"DETERMINISTIC_TOOL_SELECTED\"],\n    \"apps\": [\n      {\n        \"name\": \"orchestrator\",\n        \"type\": \"agent\",\n        \"baseUrl\": \"http://orchestrator:8000\"\n      }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/k8s/namespaces/default/multiagentsystems/prod-mas",
              "host": ["{{base_url}}"],
              "path": ["k8s", "namespaces", "default", "multiagentsystems", "prod-mas"]
            }
          }
        },
        {
          "name": "Update MAS Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": {\n    \"phase\": \"Active\",\n    \"appsReady\": 2,\n    \"lastSyncTime\": \"2025-01-15T10:30:00Z\",\n    \"message\": \"All apps reconciled\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/k8s/namespaces/default/multiagentsystems/prod-mas/status",
              "host": ["{{base_url}}"],
              "path": ["k8s", "namespaces", "default", "multiagentsystems", "prod-mas", "status"]
            }
          }
        },
        {
          "name": "Delete MAS",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/k8s/namespaces/default/multiagentsystems/prod-mas",
              "host": ["{{base_url}}"],
              "path": ["k8s", "namespaces", "default", "multiagentsystems", "prod-mas"]
            }
          }
        }
      ]
    },
    {
      "name": "ZTAPolicy CRDs",
      "item": [
        {
          "name": "Create ZTAPolicy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiVersion\": \"zta.io/v1alpha1\",\n  \"kind\": \"ZTAPolicy\",\n  \"metadata\": {\n    \"name\": \"agent-policy\",\n    \"namespace\": \"default\",\n    \"labels\": {\n      \"app\": \"orchestrator\"\n    }\n  },\n  \"spec\": {\n    \"targetRef\": {\n      \"kind\": \"Deployment\",\n      \"name\": \"orchestrator\"\n    },\n    \"allowedProtocols\": [\"mcp\", \"a2a\"],\n    \"allowedEndpoints\": [\n      {\n        \"name\": \"filesystem-mcp\",\n        \"namespace\": \"default\",\n        \"port\": 8080\n      },\n      {\n        \"name\": \"zta-auth\",\n        \"namespace\": \"zta-system\",\n        \"port\": 8443\n      }\n    ],\n    \"llmEndpoint\": {\n      \"fqdn\": \"api.openai.com\",\n      \"port\": 443\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/k8s/namespaces/default/ztapolicies",
              "host": ["{{base_url}}"],
              "path": ["k8s", "namespaces", "default", "ztapolicies"]
            }
          }
        },
        {
          "name": "Get ZTAPolicy by Name",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/k8s/namespaces/default/ztapolicies/agent-policy",
              "host": ["{{base_url}}"],
              "path": ["k8s", "namespaces", "default", "ztapolicies", "agent-policy"]
            }
          }
        },
        {
          "name": "List ZTAPolicies in Namespace",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/k8s/namespaces/default/ztapolicies",
              "host": ["{{base_url}}"],
              "path": ["k8s", "namespaces", "default", "ztapolicies"]
            }
          }
        },
        {
          "name": "List All ZTAPolicies",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/k8s/ztapolicies",
              "host": ["{{base_url}}"],
              "path": ["k8s", "ztapolicies"]
            }
          }
        },
        {
          "name": "Update ZTAPolicy Spec",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spec\": {\n    \"targetRef\": {\n      \"kind\": \"Deployment\",\n      \"name\": \"orchestrator\"\n    },\n    \"allowedProtocols\": [\"mcp\"],\n    \"allowedEndpoints\": [\n      {\n        \"name\": \"filesystem-mcp\",\n        \"namespace\": \"default\",\n        \"port\": 8080\n      }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/k8s/namespaces/default/ztapolicies/agent-policy",
              "host": ["{{base_url}}"],
              "path": ["k8s", "namespaces", "default", "ztapolicies", "agent-policy"]
            }
          }
        },
        {
          "name": "Update ZTAPolicy Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": {\n    \"phase\": \"Active\",\n    \"ciliumPolicyName\": \"cnp-agent-policy\",\n    \"lastSyncTime\": \"2025-01-15T10:30:00Z\",\n    \"message\": \"CiliumNetworkPolicy applied\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/k8s/namespaces/default/ztapolicies/agent-policy/status",
              "host": ["{{base_url}}"],
              "path": ["k8s", "namespaces", "default", "ztapolicies", "agent-policy", "status"]
            }
          }
        },
        {
          "name": "Delete ZTAPolicy",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/k8s/namespaces/default/ztapolicies/agent-policy",
              "host": ["{{base_url}}"],
              "path": ["k8s", "namespaces", "default", "ztapolicies", "agent-policy"]
            }
          }
        }
      ]
    }
  ]
}
